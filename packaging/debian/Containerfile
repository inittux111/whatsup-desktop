# Debian stable (trixie) build environment for whatsup-desktop, used with
# podman the way the Fedora build uses a toolbox. Build the image once, then
# build the .deb or run the tests with it (see the README's Debian section):
#
#   podman build -t whatsup-desktop-deb packaging/debian
#   podman run --rm -v "$PWD":/src:Z -w /src whatsup-desktop-deb make deb
#
# The committed Cargo.lock pins the crate versions; cargo fetches them from
# crates.io during the build, so the container needs network access.
#
# The Rust toolchain comes from rustup, not Debian's rustc: the gtk-rs crates
# need a newer rustc than Debian stable packages, and the toolchain used to
# compile has no bearing on the .deb's runtime dependencies, which are the
# system GTK4, libadwaita 1.7 and WebKitGTK 6.0 this image installs. Clippy is
# included so CI lints against those same libraries.
FROM docker.io/library/debian:trixie-slim

ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo \
    PATH=/opt/rust/cargo/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      pkg-config \
      make \
      dpkg-dev \
      debhelper \
      desktop-file-utils \
      libgtk-4-dev \
      libadwaita-1-dev \
      libwebkitgtk-6.0-dev \
      fonts-noto-color-emoji \
      hunspell-en-us \
      `# Only for running the app in the container to test (run.sh), not for` \
      `# building the .deb: a software GL driver and a session bus.` \
      libgl1-mesa-dri \
      dbus \
 && rm -rf /var/lib/apt/lists/* \
 && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
           --component clippy \
 && chmod -R a+rX /opt/rust
